
---
import "../styles/global.css";
import Header from "../components/Header.astro";

const organization = "TheRealArchitect";
const slogan = "Building. Preserving. Evolving.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#111111" />
    <title>{organization} — Official Portfolio</title>
    <meta
      name="description"
      content="The official portfolio of TheRealArchitect."
    />
  </head>
  <body>
    <main>
      <h1>{organization}</h1>
      <p>{slogan}</p>
      <a href="#projects">Explore projects</a>
    </main>

    <section id="projects">
      <h2>Our projects</h2>
      <p>Active projects, experiments and preserved history.</p>
    </section>
  </body>
</html>
