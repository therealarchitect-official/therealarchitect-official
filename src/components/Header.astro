
---
const links = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/projects" },
  { label: "About", href: "/about" },
  { label: "Archive", href: "/archive" },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="TheRealArchitect home">
    TheRealArchitect<span>.</span>
  </a>

  <nav aria-label="Main navigation">
    {links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    width: 100%;
    min-height: 76px;
    padding: 0 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid #303030;
    background: #171717;
  }

  .brand {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.7px;
  }

  .brand span {
    color: #a78bfa;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
  }

  nav a {
    color: #a3a3a3;
    font-size: 0.9rem;
    transition: color 180ms ease;
  }

  nav a:hover {
    color: #ffffff;
  }

  @media (max-width: 600px) {
    .site-header {
      padding: 18px 5%;
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
